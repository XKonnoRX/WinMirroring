<Window x:Class="WinMirroring.App.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMirroring"
        Width="360"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="#1F2937"
        Icon="pack://application:,,,/Assets/app.ico">
  <Window.Resources>
    <Style TargetType="ButtonBase" x:Key="QuickBase">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style TargetType="Button" x:Key="QuickButton" BasedOn="{StaticResource QuickBase}" />
    <Style TargetType="ToggleButton" x:Key="QuickToggle" BasedOn="{StaticResource QuickBase}" />
    <Style TargetType="TextBlock" x:Key="SectionHeader">
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,16,0,3" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Current">
      <Setter Property="Foreground" Value="#93C5FD" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="4,8,0,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="TextBlock" x:Key="DeviceHeader">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,10,0,2" />
    </Style>
  </Window.Resources>

  <Border BorderBrush="#374151" BorderThickness="1,0,0,0">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="14,12,10,4">
        <Button DockPanel.Dock="Right" Content="✕" Width="40" Height="34" Focusable="False" Click="OnClose"
                Background="#374151" Foreground="White" BorderThickness="0" FontSize="15" />
        <TextBlock Text="WinMirroring" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel x:Name="Sections" Margin="14,2,14,18" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
