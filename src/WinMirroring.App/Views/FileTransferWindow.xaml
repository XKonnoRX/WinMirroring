<Window x:Class="WinMirroring.App.Views.FileTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Передача файлов"
        Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" AllowsTransparency="True" Background="Transparent">
  <Border Background="#1F2937" CornerRadius="8" Padding="16,14" BorderBrush="#374151" BorderThickness="1">
    <StackPanel>
      <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="14" Text="Передача файлов" />
      <TextBlock x:Name="WhatText" Foreground="#9CA3AF" FontSize="12" Margin="0,3,0,10" TextTrimming="CharacterEllipsis" />
      <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Foreground="#3B82F6" Background="#374151" BorderThickness="0" />
      <TextBlock x:Name="PercentText" Foreground="#D1D5DB" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</Window>
