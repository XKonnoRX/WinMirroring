<Window x:Class="WinMirroring.App.Views.FloatingMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMirroring"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False"
        Icon="pack://application:,,,/Assets/app.ico">
  <Border x:Name="Handle" Width="46" Height="46" CornerRadius="23" Margin="8"
          Background="#E61F2937" BorderBrush="#4B5563" BorderThickness="1" Opacity="0.7" Cursor="Hand"
          PreviewMouseLeftButtonDown="OnButtonDown" PreviewMouseMove="OnButtonMove" PreviewMouseLeftButtonUp="OnButtonUp"
          MouseEnter="OnHoverIn" MouseLeave="OnHoverOut"
          ToolTip="Меню WinMirroring — нажмите, чтобы открыть; тяните, чтобы переместить">
    <Border.Effect>
      <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.5" />
    </Border.Effect>
    <TextBlock Text="☰" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Border.ContextMenu>
      <ContextMenu x:Name="AppMenu" />
    </Border.ContextMenu>
  </Border>
</Window>
