<Window x:Class="WinMirroring.App.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMirroring — сопряжение"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/app.ico">
  <StackPanel Margin="20">
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" TextWrapping="Wrap" />

    <TextBlock Style="{StaticResource Caption}" Text="Код подтверждения (тот же, что на другом устройстве)" HorizontalAlignment="Center" Margin="0,16,0,0" />
    <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,12" />

    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}">
          <Run Text="Другое устройство:" /> <Run x:Name="PeerFingerprintRun" FontFamily="Consolas" />
        </TextBlock>
        <TextBlock Style="{StaticResource Caption}">
          <Run Text="Это устройство:" /> <Run x:Name="LocalFingerprintRun" FontFamily="Consolas" />
        </TextBlock>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Принять" MinWidth="110" IsDefault="True" Click="OnAccept" FontWeight="SemiBold" />
      <Button Content="Отклонить" MinWidth="110" IsCancel="True" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
