<Window x:Class="WinMirroring.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMirroring"
        Width="920" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
  <DockPanel Margin="12">

    <!-- Header: this device -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="16" FontWeight="SemiBold">
            <Run Text="Это устройство:" /> <Run Text="{Binding DeviceName, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
            <Run Text="Отпечаток:" /> <Run Text="{Binding Fingerprint, Mode=OneWay}" FontFamily="Consolas" />
          </TextBlock>
          <TextBlock Style="{StaticResource Caption}" Text="{Binding NetworkSummary}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
          <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Text="{Binding InputFocusText}" />
          <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" Text="{Binding SmoothingText}" />
          <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" Text="{Binding DeviceId}" FontFamily="Consolas" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status line -->
    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" MinHeight="18" />
    </Border>

    <TabControl>

      <!-- Devices -->
      <TabItem Header="Устройства">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Сопрячь…" Command="{Binding PairCommand}" />
            <Button Content="Разорвать сопряжение" Command="{Binding UnpairCommand}" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}"
                       Text="Сопряжение запрашивается с этого устройства и подтверждается кнопкой на другом." />
          </StackPanel>
          <ListView ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Управлять этим устройством" FontWeight="SemiBold" Command="{Binding ControlPeerCommand}" />
                <MenuItem Header="Показать экран" Command="{Binding ShowScreenCommand}" />
                <MenuItem Header="Отправить окно на это устройство…" Command="{Binding SendWindowCommand}" />
                <Separator />
                <MenuItem Header="Слушать звук этого устройства здесь (вкл./выкл.)" Command="{Binding ToggleListenCommand}" />
                <MenuItem Header="Отправлять звук отсюда на это устройство (вкл./выкл.)" Command="{Binding TogglePinnedAudioCommand}" />
                <Separator />
                <MenuItem Header="Проверить задержку" Command="{Binding MeasureLatencyCommand}" />
                <MenuItem Header="Ping в консоли" Command="{Binding IcmpPingCommand}" />
                <MenuItem Header="Удалённый рабочий стол (RDP)" Command="{Binding RemoteDesktopCommand}" />
                <MenuItem Header="Открыть сетевую папку" Command="{Binding OpenShareCommand}" />
                <MenuItem Header="Копировать IP-адрес" Command="{Binding CopyAddressCommand}" />
                <MenuItem Header="Получить журнал этого устройства" Command="{Binding FetchPeerLogCommand}" />
                <Separator />
                <MenuItem Header="Переподключить" Command="{Binding ReconnectCommand}" />
                <MenuItem Header="Сопрячь…" Command="{Binding PairCommand}" />
                <MenuItem Header="Разорвать сопряжение" Command="{Binding UnpairCommand}" />
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Имя" Width="190" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Состояние" Width="180" DisplayMemberBinding="{Binding StateText}" />
                <GridViewColumn Header="Задержка" Width="80" DisplayMemberBinding="{Binding RttText}" />
                <GridViewColumn Header="Адрес" Width="160" DisplayMemberBinding="{Binding Address}" />
                <GridViewColumn Header="Сопряжено" Width="80" DisplayMemberBinding="{Binding PairedText}" />
                <GridViewColumn Header="Отпечаток" Width="170" DisplayMemberBinding="{Binding FingerprintDisplay}" />
                <GridViewColumn Header="Последняя ошибка" Width="220" DisplayMemberBinding="{Binding LastError}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>

      <!-- Layout -->
      <TabItem Header="Раскладка">
        <DockPanel Margin="8">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Расположение экранов" />
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,10"
                     Text="Расставьте устройства по сетке так, как стоят их экраны. Курсор уходит через край экрана к соседу по сетке и возвращается тем же путём. Раскладка рассылается всем сопряжённым устройствам, последняя сохранённая побеждает." />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Сохранить раскладку" FontWeight="SemiBold" Command="{Binding SaveLayoutCommand}" />
            <Button Content="Вернуть ввод сюда" Command="{Binding ReturnHomeCommand}" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Горячая клавиша возврата: Ctrl+Alt+Home." />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding LayoutCells}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" Rows="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="200" Height="104" Margin="4" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="{StaticResource PanelBrush}">
                  <StackPanel VerticalAlignment="Center" Margin="10">
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center">
                      <Run Text="колонка" /> <Run Text="{Binding Column, Mode=OneWay}" /><Run Text=", ряд" /> <Run Text="{Binding Row, Mode=OneWay}" />
                    </TextBlock>
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding DataContext.DeviceChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding Selected}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </TabItem>

      <!-- Clipboard and sound -->
      <TabItem Header="Буфер и звук">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Общий буфер обмена" />
              <CheckBox Content="Делиться буфером обмена со всеми сопряжёнными устройствами" IsChecked="{Binding ClipboardEnabled}" />
              <CheckBox Content="Передавать скопированные файлы и папки" IsChecked="{Binding ClipboardShareFiles}" IsEnabled="{Binding ClipboardEnabled}" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                         Text="Файлы не пересылаются при копировании: на другом устройстве они появляются в буфере и скачиваются только при вставке. Explorer показывает свой прогресс копирования." />
              <CheckBox Content="Перетаскивать файлы мышью через край экрана на другое устройство" IsChecked="{Binding ClipboardDragDrop}" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                         Text="Начните тянуть файлы в Explorer и уведите курсор на соседнее устройство, не отпуская кнопку. Файлы скачаются туда, куда вы их бросите. Работает в обе стороны." />
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock VerticalAlignment="Center" Text="Текст и картинки до, МБ:" Width="250" />
                <TextBox Width="60" Text="{Binding ClipboardMaxInline, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock VerticalAlignment="Center" Text="Как обычные файлы для любых программ, до МБ:" Width="250" TextWrapping="Wrap" />
                <TextBox Width="60" Text="{Binding ClipboardDirectPaste, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                         Text="Наборы файлов до этого размера вставляются и в программы, которые понимают только настоящие пути (они скачиваются в кэш в момент вставки). Большие наборы вставляются только в Explorer." />
              <TextBlock Style="{StaticResource Caption}" Text="Последнее действие:" />
              <TextBlock Text="{Binding ClipboardActivity}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Звук" />
              <CheckBox Content="Передавать звук этого устройства на другие" IsChecked="{Binding AudioSendEnabled}" />
              <CheckBox Content="Звук следует за вводом (играет там, откуда управляют этим устройством)" IsChecked="{Binding AudioFollowInput}" IsEnabled="{Binding AudioSendEnabled}" />
              <StackPanel Orientation="Horizontal" Margin="0,4" IsEnabled="{Binding AudioSendEnabled}">
                <TextBlock VerticalAlignment="Center" Text="Всегда передавать на:" Margin="0,0,6,0" />
                <ComboBox Width="220" ItemsSource="{Binding DeviceChoices}" DisplayMemberPath="Name" SelectedItem="{Binding AudioPinnedTarget}" />
              </StackPanel>
              <CheckBox Content="Выключать здесь динамики, пока звук играет на другом устройстве" IsChecked="{Binding AudioMuteLocal}" IsEnabled="{Binding AudioSendEnabled}" />
              <CheckBox Content="Воспроизводить звук, который присылают другие устройства" IsChecked="{Binding AudioReceiveEnabled}" Margin="0,8,0,4" />
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock VerticalAlignment="Center" Text="Битрейт Opus, кбит/с:" Width="200" />
                <TextBox Width="60" Text="{Binding AudioBitrate, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock VerticalAlignment="Center" Text="Буфер воспроизведения, мс:" Width="200" />
                <TextBox Width="60" Text="{Binding AudioBuffer, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                         Text="Меньше буфер — меньше задержка звука, но больше риск щелчков на нестабильном Wi-Fi. 30–60 мс обычно достаточно." />
              <TextBlock Style="{StaticResource Caption}" Text="Состояние:" />
              <TextBlock Text="{Binding AudioStatusText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Screen -->
      <TabItem Header="Экран">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Доступ к этому устройству" />
            <CheckBox Content="Разрешить сопряжённым устройствам смотреть экран и окна" IsChecked="{Binding ScreenAllowViewing}" />
            <CheckBox Content="Разрешить управлять из окна просмотра (мышь, касания, клавиатура)" IsChecked="{Binding ScreenAllowControl}" IsEnabled="{Binding ScreenAllowViewing}" />
            <CheckBox Content="Перетаскивать окна за заголовок через край экрана на другое устройство" IsChecked="{Binding ScreenWindowDrag}" IsEnabled="{Binding ScreenAllowViewing}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                       Text="Потяните окно за заголовок и уведите курсор на соседнее устройство: там откроется окно с его изображением и управлением, а здесь окно вернётся на место. Отправить окно можно и из меню устройства." />
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <TextBlock VerticalAlignment="Center" Text="Кадров в секунду, не больше:" Width="210" />
              <TextBox Width="60" Text="{Binding ScreenMaxFps, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <TextBlock VerticalAlignment="Center" Text="Качество JPEG, 30–95:" Width="210" />
              <TextBox Width="60" Text="{Binding ScreenQuality, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                       Text="Передаются только изменившиеся участки экрана, частота кадров сама подстраивается под сеть. Посмотреть экран другого устройства: правая кнопка по нему на вкладке «Устройства» → «Показать экран». В окне просмотра можно выделить часть изображения." />
          </StackPanel>

          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Что сейчас показывается другим" />
            <ListBox ItemsSource="{Binding ScreenSources}" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Остановить" Margin="8,0,0,0"
                            Command="{Binding DataContext.StopScreenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="→" />
                      <Run Text="{Binding PeerName, Mode=OneWay}" />
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- Network -->
      <TabItem Header="Сеть">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Column="0" Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Интерфейсы и подсети" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,6"
                       Text="Узел слушает и ищет устройства только в отмеченных подсетях. Если не отмечено ничего, используются все." />
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Обновить список" Command="{Binding RefreshInterfacesCommand}" />
            <ListBox ItemsSource="{Binding Interfaces}" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}">
                    <StackPanel>
                      <TextBlock>
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding Address, Mode=OneWay}" FontFamily="Consolas" />
                      </TextBlock>
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <DockPanel Grid.Column="2" Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Адреса вручную (VPN)" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,6"
                       Text="Через VPN широковещание не ходит: укажите имя или IP устройства, при необходимости с портом обнаружения (host:47620)." />
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Content="Удалить" Command="{Binding RemoveManualAddressCommand}" Margin="8,0,0,0" />
              <Button DockPanel.Dock="Right" Content="Добавить" Command="{Binding AddManualAddressCommand}" IsDefault="True" Margin="8,0,0,0" />
              <TextBox Text="{Binding NewManualAddress, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ListBox ItemsSource="{Binding ManualAddresses}" SelectedItem="{Binding SelectedManualAddress}" />
          </DockPanel>

          <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Text="UDP обнаружение:" Margin="0,0,6,0" />
              <TextBox Width="70" Text="{Binding DiscoveryPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
              <TextBlock VerticalAlignment="Center" Text="TCP транспорт:" Margin="0,0,6,0" />
              <TextBox Width="70" Text="{Binding TransportPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
              <Button Content="Применить" Command="{Binding ApplyNetworkCommand}" FontWeight="SemiBold" />
              <Button Content="Добавить правило брандмауэра…" Command="{Binding AddFirewallRulesCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Settings -->
      <TabItem Header="Настройки">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Имя устройства" />
          <TextBlock Style="{StaticResource Caption}" Text="Под этим именем устройство видят остальные. Применяется кнопкой «Применить» на вкладке «Сеть»." Margin="0,0,0,6" />
          <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

          <TextBlock Style="{StaticResource SectionTitle}" Text="Общий ввод" />
          <CheckBox Content="Делить мышь и клавиатуру с другими устройствами" IsChecked="{Binding InputEnabled}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <TextBlock VerticalAlignment="Center" Text="Сопротивление края, пикселей:" Margin="0,0,6,0" />
            <TextBox Width="60" Text="{Binding EdgeResistance, UpdateSourceTrigger=LostFocus}" />
          </StackPanel>
          <CheckBox Content="Сглаживать движение мыши при нестабильной сети" IsChecked="{Binding SmoothingEnabled}" Margin="0,8,0,4" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsEnabled="{Binding SmoothingEnabled}">
            <TextBlock VerticalAlignment="Center" Text="Максимальная задержка буфера, мс:" Margin="0,0,6,0" />
            <TextBox Width="60" Text="{Binding MaxSmoothingDelay, UpdateSourceTrigger=LostFocus}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                     Text="Работает на том устройстве, которым управляют: пакеты, пришедшие пачкой, проигрываются с исходными интервалами. Буфер сам подстраивается под разброс задержки и не превышает указанный предел. Саму задержку сети это не убирает." />
          <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                     Text="Окна с правами администратора и UAC не принимают ввод от обычного приложения: пока курсор над ними, управление с другого устройства не работает. Это ограничение Windows, служба для обхода запланирована." />

          <TextBlock Style="{StaticResource SectionTitle}" Text="Запуск" />
          <CheckBox Content="Запускать при входе в Windows (свернуто в трей)" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,16" />

          <TextBlock Style="{StaticResource SectionTitle}" Text="Диагностика" />
          <TextBlock Style="{StaticResource Caption}" Text="Что запустилось на этом устройстве:" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding FeatureStatuses}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" Margin="0,1">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#047857" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Ok}" Value="False">
                          <Setter Property="Foreground" Value="#B91C1C" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <Run Text="{Binding Mark, Mode=OneWay}" /> <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Detail, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                     Text="Журнал другого устройства можно получить отсюда: правая кнопка по нему на вкладке «Устройства» → «Получить журнал этого устройства»." />
          <StackPanel Orientation="Horizontal">
            <Button Content="Открыть папку журналов" Command="{Binding OpenLogsCommand}" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
