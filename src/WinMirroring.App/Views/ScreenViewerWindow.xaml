<Window x:Class="WinMirroring.App.Views.ScreenViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMirroring — экран"
        Width="1100" Height="700" MinWidth="320" MinHeight="200"
        Background="#111111"
        Icon="pack://application:,,,/Assets/app.ico">
  <Window.Resources>
    <Style TargetType="ButtonBase" x:Key="ToolButton">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ToolButton}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}" />

    <!-- Quick panel: large targets for fingers -->
    <Style TargetType="ButtonBase" x:Key="QuickBase">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style TargetType="Button" x:Key="QuickButton" BasedOn="{StaticResource QuickBase}" />
    <Style TargetType="ToggleButton" x:Key="QuickToggle" BasedOn="{StaticResource QuickBase}" />
    <Style TargetType="TextBlock" x:Key="QuickHeader">
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="2,12,0,2" />
    </Style>

    <!-- Button bar over the picture: finger-sized, dark, never takes keyboard focus from the picture -->
    <Style TargetType="ButtonBase" x:Key="BarBase">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#374151" />
      <Setter Property="BorderBrush" Value="#4B5563" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9CA3AF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1D4ED8" />
              </Trigger>
              <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#2563EB" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="BarButton" BasedOn="{StaticResource BarBase}" />
    <Style TargetType="ToggleButton" x:Key="BarToggle" BasedOn="{StaticResource BarBase}" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="Toolbar" Grid.Row="0" Background="#1F2937" Padding="8,4">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        <StackPanel x:Name="MonitorPanel" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
          <Button Content="◀" ToolTip="Предыдущий монитор" Click="OnPreviousMonitor" MinWidth="32" Padding="6,2" Margin="0" />
          <TextBlock x:Name="MonitorText" VerticalAlignment="Center" Foreground="#D1D5DB" Margin="6,0" />
          <Button Content="▶" ToolTip="Следующий монитор" Click="OnNextMonitor" MinWidth="32" Padding="6,2" Margin="0" />
        </StackPanel>

        <TextBlock x:Name="StatsText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="12,0,0,0" MinWidth="70" />
        <Button DockPanel.Dock="Right" Content="☰ Меню" Click="OnToggleQuickPanel" FontWeight="SemiBold"
                ToolTip="Быстрые параметры: звук, курсор, полноэкранный режим, часть изображения" />
        <Button DockPanel.Dock="Right" Content="Во весь экран (F11)" Click="OnToggleFullScreen" />
        <Button x:Name="KeyboardButton" DockPanel.Dock="Right" Content="Клавиатура" Click="OnToggleKeyboard"
                ToolTip="Экранная клавиатура: нажатия уходят на другое устройство" />
      </DockPanel>
    </Border>

    <Grid x:Name="Surface" Grid.Row="1" Background="Black" ClipToBounds="True" AllowDrop="True"
          DragEnter="OnSurfaceDragOver" DragOver="OnSurfaceDragOver" Drop="OnSurfaceDrop">
      <Image x:Name="ScreenImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" Focusable="True" FocusVisualStyle="{x:Null}"
             Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
             Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False" />
      <Canvas x:Name="Overlay" IsHitTestVisible="False">
        <Rectangle x:Name="CropRectangle" Stroke="#3B82F6" StrokeThickness="2" Fill="#333B82F6" Visibility="Collapsed" />
      </Canvas>
      <TextBlock x:Name="WaitingText" Text="Ожидание изображения…" Foreground="#9CA3AF" FontSize="16"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>

    <!-- Buttons that press keys on the other device (presets from the main menu), over the bottom of the picture.
         A press here never reaches the picture below. -->
    <Border x:Name="ButtonBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="8,0,8,8"
            Background="#D9111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="10" Padding="5" Visibility="Collapsed">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
        <StackPanel x:Name="ButtonBarItems" Orientation="Horizontal" />
      </ScrollViewer>
    </Border>

    <Border x:Name="NoticeBorder" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
            Background="#E61F2937" CornerRadius="6" Padding="14,8" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="NoticeText" Foreground="#FBBF24" FontSize="14" TextWrapping="Wrap" MaxWidth="520" />
    </Border>

    <!-- In full screen the toolbar is gone: this handle opens the quick panel (and the way out). It sits on the
         right, where the panel slides out from. -->
    <Button x:Name="FullScreenHandle" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,8,0"
            Content="☰  Меню" FontSize="14" Padding="18,6" MinHeight="36" Opacity="0.55" Visibility="Collapsed"
            Background="#CC1F2937" Foreground="White" BorderBrush="#4B5563" Focusable="False"
            Click="OnToggleQuickPanel" ToolTip="Быстрые параметры и выход из полноэкранного режима" />

    <!-- Borderless window view: an invisible strip over the top of the window to drag it (a plain click passes
         through to the window below), and a small menu button since there is no toolbar. -->
    <Border x:Name="DragStrip" Grid.Row="1" VerticalAlignment="Top" Height="34" Background="Transparent" Visibility="Collapsed"
            PreviewMouseLeftButtonDown="OnDragStripDown" PreviewMouseMove="OnDragStripMove" PreviewMouseLeftButtonUp="OnDragStripUp" />
    <Button x:Name="WindowMenuButton" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,3,0,0"
            Content="☰" FontSize="13" Padding="8,2" MinHeight="26" Opacity="0.5" Visibility="Collapsed"
            Background="#CC1F2937" Foreground="White" BorderBrush="#4B5563" Focusable="False"
            Click="OnToggleQuickPanel" ToolTip="Меню" />

    <Border x:Name="QuickPanel" Grid.Row="1" HorizontalAlignment="Right" Width="320" Background="#F21F2937"
            BorderBrush="#374151" BorderThickness="1,0,0,0" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="14,10,14,14">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource QuickButton}" MinWidth="40" HorizontalContentAlignment="Center"
                    Click="OnToggleQuickPanel" ToolTip="Закрыть панель" />
            <TextBlock x:Name="QuickTitle" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>

          <TextBlock Style="{StaticResource QuickHeader}" Text="ОКНО" />
          <ToggleButton x:Name="FullScreenToggle" Style="{StaticResource QuickToggle}" Content="Во весь экран" Click="OnFullScreenToggleClick" />
          <Button Style="{StaticResource QuickButton}" Content="Свернуть" Click="OnMinimize" ToolTip="Убрать окно на панель задач, не закрывая его" />
          <Button x:Name="CloseViewerButton" Style="{StaticResource QuickButton}" Content="Закрыть просмотр" Click="OnCloseViewer" />

          <TextBlock Style="{StaticResource QuickHeader}" Text="УПРАВЛЕНИЕ" />
          <ToggleButton x:Name="ControlToggle" Style="{StaticResource QuickToggle}" Content="Мышь, касания и клавиатура управляют тем устройством" IsChecked="True"
                        Click="OnControlToggleClick" />
          <Button x:Name="QuickKeyboardButton" Style="{StaticResource QuickButton}" Content="Экранная клавиатура" Click="OnToggleKeyboard" />
          <Button x:Name="AltTabButton" Style="{StaticResource QuickButton}" Content="Alt+Tab — переключить окно там" Click="OnAltTab"
                  ToolTip="Переключает окно на том устройстве (локально Alt+Tab перехватывает Windows)" />
          <Button Style="{StaticResource QuickButton}" Content="Отпустить зажатые кнопки и клавиши там" Click="OnReleaseRemoteInput" />
          <Button Style="{StaticResource QuickButton}" Content="Вернуть курсор (общий ввод)" Click="OnReturnCursor"
                  ToolTip="Если курсор общего ввода застрял на другом устройстве, вернуть его на место" />

          <TextBlock Style="{StaticResource QuickHeader}" Text="ЗВУК" />
          <ToggleButton x:Name="ListenToggle" Style="{StaticResource QuickToggle}" Click="OnListenToggleClick" />
          <ToggleButton x:Name="SendSoundToggle" Style="{StaticResource QuickToggle}" Click="OnSendSoundToggleClick" />
          <ToggleButton x:Name="KeepSoundToggle" Style="{StaticResource QuickToggle}" Content="Звук этого устройства — только здесь" Click="OnKeepSoundToggleClick" />

          <TextBlock x:Name="ImageHeader" Style="{StaticResource QuickHeader}" Text="ИЗОБРАЖЕНИЕ" />
          <DockPanel x:Name="QuickMonitorPanel">
            <Button DockPanel.Dock="Left" Style="{StaticResource QuickButton}" Content="◀" MinWidth="48" HorizontalContentAlignment="Center" Click="OnPreviousMonitor" />
            <Button DockPanel.Dock="Right" Style="{StaticResource QuickButton}" Content="▶" MinWidth="48" HorizontalContentAlignment="Center" Click="OnNextMonitor" />
            <TextBlock x:Name="QuickMonitorText" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
          </DockPanel>
          <ToggleButton x:Name="CropToggle" Style="{StaticResource QuickToggle}" Content="Выделить часть рамкой" Click="OnCropToggleClick"
                        ToolTip="Обведите рамкой часть изображения: передаваться будет только она" />
          <Button x:Name="ResetCropButton" Style="{StaticResource QuickButton}" Content="Показать всё целиком" Click="OnResetCrop" IsEnabled="False" />

          <TextBlock Style="{StaticResource QuickHeader}" Text="БУФЕР ОБМЕНА" />
          <Button x:Name="ClipboardButton" Style="{StaticResource QuickButton}" Content="Отправить буфер обмена ещё раз" Click="OnSendClipboard"
                  ToolTip="Обычно буфер отправляется сам при копировании; это нужно, если копировали до подключения" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
