<Window x:Class="WinMirroring.App.Views.ScreenViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMirroring — экран"
        Width="1100" Height="700" MinWidth="320" MinHeight="200"
        Background="#111111"
        Icon="pack://application:,,,/Assets/app.ico">
  <DockPanel>
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="#1F2937" Padding="8,4">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
        <StackPanel x:Name="MonitorPanel" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
          <Button Content="◀" ToolTip="Предыдущий монитор" Click="OnPreviousMonitor" MinWidth="32" Padding="6,2" />
          <TextBlock x:Name="MonitorText" VerticalAlignment="Center" Foreground="#D1D5DB" Margin="6,0" />
          <Button Content="▶" ToolTip="Следующий монитор" Click="OnNextMonitor" MinWidth="32" Padding="6,2" />
        </StackPanel>

        <TextBlock x:Name="StatsText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="12,0,0,0" MinWidth="70" />
        <Button DockPanel.Dock="Right" Content="Во весь экран (F11)" Click="OnToggleFullScreen" Padding="8,2" Margin="4,0,0,0" />
        <Button x:Name="ResetCropButton" DockPanel.Dock="Right" Content="Всё целиком" Click="OnResetCrop" Padding="8,2" Margin="4,0,0,0" IsEnabled="False" />
        <ToggleButton x:Name="CropToggle" DockPanel.Dock="Right" Content="Выделить часть" Padding="8,2" Margin="4,0,0,0"
                      ToolTip="Обведите рамкой часть изображения: передаваться будет только она" />
        <ToggleButton x:Name="ControlToggle" DockPanel.Dock="Right" Content="Управление" Padding="8,2" Margin="4,0,0,0" IsChecked="True"
                      ToolTip="Мышь, касания и клавиатура в этом окне управляют другим устройством" />
      </DockPanel>
    </Border>

    <Grid x:Name="Surface" Background="Black" ClipToBounds="True">
      <Image x:Name="ScreenImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" Focusable="True" />
      <Canvas x:Name="Overlay" IsHitTestVisible="False">
        <Rectangle x:Name="CropRectangle" Stroke="#3B82F6" StrokeThickness="2" Fill="#333B82F6" Visibility="Collapsed" />
      </Canvas>
      <TextBlock x:Name="WaitingText" Text="Ожидание изображения…" Foreground="#9CA3AF" FontSize="16"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </DockPanel>
</Window>
