<Window x:Class="WinMirroring.App.Views.WebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WinMirroring"
        Width="1180" Height="800" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116"
        Icon="pack://application:,,,/Assets/app.ico">
  <Grid>
    <!-- Shown until the page has painted, so the window never flashes white. -->
    <TextBlock x:Name="LoadingText" Text="Загрузка…" Foreground="#697385" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <wv2:WebView2 x:Name="View" Visibility="Hidden" DefaultBackgroundColor="#0E1116" />
  </Grid>
</Window>
